{
  "name": "autopg",
  "version": "3.1.0",
  "description": "Embedded PostgreSQL server with true concurrent connections - zero config, auto-provision databases",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "autopg": "./bin/autopg-wrapper.cjs"
  },
  "files": [
    "bin/",
    "src/",
    "config/",
    "console/dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "scripts/"
  ],
  "scripts": {
    "test": "bun test tests/**/*.test.js",
    "test:watch": "bun test --watch tests/**/*.test.js",
    "dev": "bun --watch bin/postgres-server.js",
    "start": "bun bin/postgres-server.js",
    "build": "bun build --compile bin/postgres-server.js --outfile dist/pgserve",
    "build:all": "make build-all",
    "console:build": "bun build console/src/main.jsx --target browser --minify --define 'process.env.NODE_ENV=\"production\"' --outfile console/dist/app.js && cp console/src/index.html console/dist/index.html && cp console/src/*.css console/dist/",
    "console:dev": "bun build console/src/main.jsx --target browser --define 'process.env.NODE_ENV=\"development\"' --watch --outfile console/dist/app.js",
    "lint": "eslint src/ bin/",
    "lint:fix": "eslint src/ bin/ --fix",
    "lint:audit": "bun scripts/audit-redaction-lint.js",
    "deadcode": "knip",
    "prepublishOnly": "npm run console:build && npm run lint && npm run deadcode",
    "prepare": "husky"
  },
  "keywords": [
    "postgresql",
    "embedded",
    "database",
    "postgres",
    "development",
    "multi-tenant"
  ],
  "author": "Namastex Labs <labs@namastex.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/automagik-dev/autopg.git"
  },
  "bugs": {
    "url": "https://github.com/automagik-dev/autopg/issues"
  },
  "homepage": "https://github.com/automagik-dev/autopg#readme",
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.3.0-beta.17",
    "@embedded-postgres/darwin-x64": "18.3.0-beta.17",
    "@embedded-postgres/linux-arm64": "18.3.0-beta.17",
    "@embedded-postgres/linux-x64": "18.3.0-beta.17",
    "@embedded-postgres/windows-x64": "18.3.0-beta.17"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "knip": "^5.71.0",
    "lint-staged": "^16.2.7",
    "pg": "^8.16.3"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix"
    ],
    "bin/**/*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "bun": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
